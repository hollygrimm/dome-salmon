[ext_resource type="Script" uid="uid://c2t17ccrwbh56" path="res://scripts/CulturalValue.gd" id="1_culturalvalue"]

[resource]
script = ExtResource("1_culturalvalue")
name = "Endurance"
description = "The salmon's long carry — holding strength through the wandering miles, then giving it all to the upstream push at the headwaters. High cohesion keeps the school together through the run; care holds the wandering longer before the spawning urgency tips them upstream."
cohesion = 0.6
playfulness = 1.0
care = 0.6
